\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Confirmatory per-class hit@0.10 on the untouched test set (seed-averaged). The oracle conditioning gain is proportionally largest on \emph  {scroll} (A 0.064{} $\to $ D-hook 0.162{}, a $2.5\times $ relative improvement) and modest on \emph  {click} (0.312{} $\to $ 0.366{}). The auxiliary loss (B) improves click slightly while \emph  {harming} scroll. \emph  {type} remains exactly $0.000$ for every variant: AITW type coordinates are degenerate.}}{7}{table.3}\protected@file@percent }
\newlabel{tab:confperclass}{{3}{7}{Confirmatory per-class hit@0.10 on the untouched test set (seed-averaged). The oracle conditioning gain is proportionally largest on \emph {scroll} (A \ConfAscroll {} $\to $ D-hook \ConfDhscroll {}, a $\ConfScrollFold \times $ relative improvement) and modest on \emph {click} (\ConfAclick {} $\to $ \ConfDhclick {}). The auxiliary loss (B) improves click slightly while \emph {harming} scroll. \emph {type} remains exactly $0.000$ for every variant: AITW type coordinates are degenerate}{table.3}{}}
